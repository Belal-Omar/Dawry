# Dawry Platform Environment Configuration
NODE_ENV=production
PORT=3001

# Strong random secret for signing session tokens (change in production!)
JWT_SECRET=replace_with_a_long_random_64_char_secret

# Optional: Super Admin password override
ADMIN_PASSWORD=admin123

# Optional: Persistent SQLite disk path (e.g. /var/data/dawry.db on Render/Railway)
DAWRY_DB_PATH=
